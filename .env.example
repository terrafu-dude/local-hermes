# Local secrets — copy this file to `.env` and fill in the value.
# `.env` is git-ignored and never committed. docker-compose and the model
# download scripts read HF_TOKEN to authenticate to Hugging Face and avoid
# anonymous rate limits. No cloud LLM keys are needed: everything runs locally.

# Stable token the Desktop app uses to authenticate /api/ws. The gateway
# auto-generates an ephemeral one that rotates on every restart, which is why the
# Desktop keeps dropping its live socket — set a fixed random value here and paste
# it into the Desktop's gateway connection so ?token= stays valid across restarts.
#   generate one: openssl rand -hex 24
DASHBOARD_SESSION_TOKEN=
HF_TOKEN=

# VNC password for the in-container "bot screen" desktop (the Hermes Desktop app
# connects to vnc://localhost:5901). The TigerVNC + XFCE desktop is baked into
# the hermes image — nothing installed on the host, no sudo.
VNC_PASSWORD=hermes
